# ---------------------------------------------------------------------------
# Cadence environment
#
#   cp .env.example .env.local   and fill in the values below.
#
# Only DATABASE_URL and AUTH_SECRET are needed to boot. Everything else
# degrades gracefully — see the notes on each block.
# ---------------------------------------------------------------------------

# --- Auth.js -----------------------------------------------------------------
# Required. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Google OAuth. Leave both blank for local development and use the dev sign-in
# below instead; the login page hides the Google button when they are unset.
# Redirect URI to register: http://localhost:3003/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Production only. Auth.js infers the URL locally and on Vercel.
# AUTH_URL=https://cadence.example.com


# --- Database (Neon) ---------------------------------------------------------
# Required. Create a free project at https://neon.tech and copy both strings
# from the dashboard's connection details.
#   DATABASE_URL          pooled  — used by the app at runtime
#   DATABASE_URL_UNPOOLED direct  — used by drizzle-kit migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- User API-key encryption (optional) --------------------------------------
# Users add their own provider API key during onboarding or in Settings. Keys are encrypted at
# rest with AES-256-GCM using a key derived from this secret. If unset, it is
# derived from AUTH_SECRET instead — which works, but means rotating AUTH_SECRET
# makes stored keys undecryptable and users must re-enter them. Set a dedicated
# value in production:  openssl rand -base64 32
# BYOK_ENCRYPTION_KEY=

# --- Upstash Redis (optional) ------------------------------------------------
# Rate limits /api/generate to one call per 10s per user. Unset locally means
# unthrottled, with a warning on the server console. Set these in production —
# it is the one route that costs money per request.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- LaTeX (optional) --------------------------------------------------------
# Only needed if your TeX engine is not on PATH. Cadence tries `tectonic`
# first, then `pdflatex`.
# TECTONIC_PATH=/opt/homebrew/bin/tectonic
# PDFLATEX_PATH=/Library/TeX/texbin/pdflatex

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3003
